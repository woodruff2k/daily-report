generator client {
  provider = "prisma-client-js"
}

// prisma / @prisma/client 는 6.19.3 으로 정확히 고정되어 있다.
// 이 프로젝트는 Prisma 6 에서 유지하기로 결정했다. 7.x 로 올리지 않는다.
//
// 7.x 는 아래 datasource 블록의 url 폐기에 더해 제너레이터 교체, import 경로 변경,
// 드라이버 어댑터 필수화, ESM 전환, Node 20.19 이상 요구가 함께 따라온다.
// 학습용 프로젝트 범위에 비해 비용이 커서 올리지 않기로 했다.
//
// npm audit 이 prisma(CLI) 에 high 3건(@prisma/config → deepmerge-ts < 8)을 보고하지만
// 6.x 최신이 6.19.3 이라 6.x 안에는 fix 가 없다. audit 이 제안하는 6.12.0 은 다운그레이드다.
// 경로는 CLI 의 config 병합뿐이고 CLI 는 운영 이미지에 없다(#97). 올리지도 내리지도 않는다.
//
// 다시 검토한다면 이슈 #37 의 코멘트에 남은 작업 목록이 정리되어 있다.
// (배경: Issue #28, #37, PR #22)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────
// Enums
// ──────────────────────────────

enum RepStatus {
  ACTIVE
  INACTIVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
}

enum VisitType {
  VISIT   // 방문
  CALL    // 전화
  ONLINE  // 온라인
}

enum ProblemStatus {
  OPEN
  CLOSED
}

enum Role {
  SALES_REP
  MANAGER
  ADMIN
}

// ──────────────────────────────
// Models
// ──────────────────────────────

model SalesRep {
  repId      BigInt    @id @default(autoincrement()) @map("rep_id")
  empNo      String    @unique @map("emp_no")
  name       String
  email      String    @unique
  department String?
  position   String?
  managerId  BigInt?   @map("manager_id")
  passwordHash String  @map("password_hash")
  // 관리자가 발급한 임시 비밀번호 상태. true 면 본인이 바꾸기 전까지
  // 비밀번호 변경 외의 API 를 쓸 수 없다. (이슈 #44)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // 발급된 토큰을 무효화하는 수단. 비밀번호 변경·재발급, 비활성화, 역할 변경,
  // 로그아웃 시 올린다. 프록시가 토큰의 값과 비교해 다르면 401 로 막는다.
  // JWT 는 상태가 없어 만료 전에는 거둬들일 방법이 없다. (이슈 #52)
  tokenVersion Int @default(0) @map("token_version")
  role       Role      @default(SALES_REP)
  status     RepStatus @default(ACTIVE)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // 자기참조: 상급자(manager) ↔ 부하(subordinates)
  manager      SalesRep?  @relation("ManagerSubordinate", fields: [managerId], references: [repId])
  subordinates SalesRep[] @relation("ManagerSubordinate")

  dailyReports      DailyReport[]
  assignedCustomers Customer[]
  comments          ReportComment[]

  @@map("sales_rep")
}

model Customer {
  customerId    BigInt    @id @default(autoincrement()) @map("customer_id")
  customerName  String    @map("customer_name")
  companyName   String?   @map("company_name")
  phone         String?
  email         String?
  address       String?
  grade         String?
  assignedRepId BigInt?   @map("assigned_rep_id")
  status        RepStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignedRep SalesRep?       @relation(fields: [assignedRepId], references: [repId])
  visits      VisitRecord[]
  problems    ReportProblem[]
  plans       ReportPlan[]

  @@map("customer")
}

model DailyReport {
  reportId    BigInt       @id @default(autoincrement()) @map("report_id")
  repId       BigInt       @map("rep_id")
  reportDate  DateTime     @map("report_date") @db.Date
  status      ReportStatus @default(DRAFT)
  submittedAt DateTime?    @map("submitted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  rep      SalesRep        @relation(fields: [repId], references: [repId])
  visits   VisitRecord[]
  problems ReportProblem[]
  plans    ReportPlan[]
  comments ReportComment[]

  // FR-03: 사원 + 보고일자 유일 제약
  @@unique([repId, reportDate])
  @@map("daily_report")
}

model VisitRecord {
  visitId    BigInt    @id @default(autoincrement()) @map("visit_id")
  reportId   BigInt    @map("report_id")
  customerId BigInt    @map("customer_id")
  visitTime  String?   @map("visit_time") // HH:mm
  visitType  VisitType @map("visit_type")
  content    String
  result     String?
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  report   DailyReport @relation(fields: [reportId], references: [reportId])
  customer Customer    @relation(fields: [customerId], references: [customerId])

  @@map("visit_record")
}

model ReportProblem {
  problemId  BigInt        @id @default(autoincrement()) @map("problem_id")
  reportId   BigInt        @map("report_id")
  customerId BigInt?       @map("customer_id") // 선택
  content    String
  status     ProblemStatus @default(OPEN)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")

  report   DailyReport @relation(fields: [reportId], references: [reportId])
  customer Customer?   @relation(fields: [customerId], references: [customerId])

  @@map("report_problem")
}

model ReportPlan {
  planId      BigInt    @id @default(autoincrement()) @map("plan_id")
  reportId    BigInt    @map("report_id")
  customerId  BigInt?   @map("customer_id") // 선택
  plannedDate DateTime? @map("planned_date") @db.Date // 선택
  content     String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  report   DailyReport @relation(fields: [reportId], references: [reportId])
  customer Customer?   @relation(fields: [customerId], references: [customerId])

  @@map("report_plan")
}

model ReportComment {
  commentId       BigInt   @id @default(autoincrement()) @map("comment_id")
  reportId        BigInt   @map("report_id")
  commenterId     BigInt   @map("commenter_id")
  parentCommentId BigInt?  @map("parent_comment_id") // 선택 (대댓글)
  content         String
  createdAt       DateTime @default(now()) @map("created_at")
  // 소프트 삭제. 대댓글이 달린 댓글만 채운다(없는 댓글은 물리 삭제).
  // updatedAt 은 두지 않는다 — "수정됨" 표시를 요구하는 요구사항이 없다.
  deletedAt DateTime? @map("deleted_at")

  report    DailyReport     @relation(fields: [reportId], references: [reportId])
  commenter SalesRep        @relation(fields: [commenterId], references: [repId])

  // 자기참조: 부모 댓글 ↔ 대댓글(replies)
  parent  ReportComment?  @relation("CommentReplies", fields: [parentCommentId], references: [commentId])
  replies ReportComment[] @relation("CommentReplies")

  @@map("report_comment")
}
